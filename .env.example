# =====================================================================
# SPMB SMPS AL-HADIID CILEUNGSI - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Salin file ini menjadi .env sebelum menjalankan aplikasi di server lokal atau produksi:
# cp .env.example .env
# =====================================================================

# Server Port (Wajib 3000 untuk lingkungan container Cloud Run / AI Studio)
PORT=3000

# AI Studio & Generative AI Variables (Server-Side Only)
GEMINI_API_KEY=
APP_URL=

# ---------------------------------------------------------------------
# SUPABASE CLIENT CONFIGURATION (Browser / Frontend Accessible)
# PENTING: Variabel berawalan VITE_ akan diekspos ke bundle browser client.
# HANYA gunakan Anon Key (public key) di sini.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# SUPABASE SERVER-SIDE CONFIGURATION (Backend Express Proxy Only)
# PENTING: Variabel di bawah ini TIDAK boleh berawalan VITE_.
# Jangan pernah mengekspos SERVICE_ROLE_KEY ke sisi browser client!
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# CORS & NETWORK SECURITY
# ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
